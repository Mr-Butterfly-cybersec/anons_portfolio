# AWS region containing your AMI
AWS_REGION=ap-south-1

# Dedicated IAM credentials for this Vercel app.
# NEVER put these in frontend JavaScript.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Your clean imported AMI
AMI_ID=ami-xxxxxxxxxxxxxxxxx

# Network where the VM should launch
SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx
SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx

# Optional. Leave empty if you do not need a named EC2 key pair.
KEY_NAME=

# Keep this modest while testing.
INSTANCE_TYPE=t3.micro

# Optional public hostname/title shown by the frontend.
NEXT_PUBLIC_PORTAL_NAME=BLACKBOX
